# Allow only the deployable application and its root deployment files.
/*
!/.gitignore
!/.dockerignore
!/.env.example
!/README.md
!/Dockerfile
!/docker-compose.yml
!/backend/
!/frontend/

# Never commit local datasets or generated runtime data.
backend/data/
backend/work/

# Python generated files and environments
__pycache__/
*.py[cod]
*.egg-info/
*.egg
.eggs/
dist/
build/
.venv/
venv/
env/

# Node generated files and dependencies
node_modules/
frontend/dist/
frontend/build/
frontend/.vite/
*.tsbuildinfo

# Local environment files
.env
.env.*
!/.env.example

# IDE and editor state
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Logs and test caches
*.log
logs/
.pytest_cache/
backend/.pytest-tmp/
.ruff_cache/
.mypy_cache/
coverage/
htmlcov/
