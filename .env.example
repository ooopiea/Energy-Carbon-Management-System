# Copy to .env and fill this value locally. Never commit the real key.
ZAI_API_KEY=

# Official Zhipu OpenAI-compatible endpoint and a tool-calling model.
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
GLM_MODEL=glm-5.2
GLM_THINKING=enabled
GLM_TIMEOUT_SECONDS=45
GLM_MAX_RETRIES=2

ENERGY_AUTO_APPROVE=false
ENERGY_SIMULATION_LOOP=true
ENERGY_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
